---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// A report is a directory of numbered parts, so group the flat collection back
// into the reports the reader actually thinks in. The slug's first segment is
// the report; the rest is the part.
const parts = await getCollection('reports');

const grouped = new Map<string, { slug: string; title: string; partCount: number }>();

for (const part of parts) {
	const [reportSlug] = part.id.split('/');
	if (!reportSlug) continue;

	const existing = grouped.get(reportSlug);

	// Part 0 is the overview and carries the title a reader should see.
	if (!existing) {
		grouped.set(reportSlug, {
			slug: reportSlug,
			title: part.data.part === 0 ? part.data.title : reportSlug,
			partCount: 1,
		});
		continue;
	}

	existing.partCount += 1;
	if (part.data.part === 0) existing.title = part.data.title;
}

const reports = [...grouped.values()].sort((a, b) => a.slug.localeCompare(b.slug));

const blurbs: Record<string, string> = {
	'the-effortless-encoder':
		'Why a self-hosted media server ended up writing its own encoder, what "it just plays" actually costs, and every promise that decision now has to keep.',
	'waking-the-television':
		'Nine months, two app generations, and three codebases getting a Chromecast to wake reliably and stay put. What was tried, what failed, why it failed, and a practical guide for anyone building Cast support into an app that also runs a TV UI.',
};
---

<BaseLayout
	title="Reports — Shipping in the Dark"
	description="Long-form explainers on how NoMercy is built, one subsystem at a time."
>
	<Header />

	<main class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
		<h1 class="text-3xl font-bold text-surface-100 light:text-surface-900">Reports</h1>

		<p class="mt-3 max-w-2xl text-surface-400 light:text-surface-600">
			Entries are what happened on a given day. Reports are the long version: one
			subsystem, taken apart properly, for anyone who wants to know how a piece of
			this actually works rather than what broke in it this week.
		</p>

		<ul class="mt-10 space-y-6 list-none pl-0">
			{reports.map((report) => (
				<li class="rounded-lg border border-surface-800 p-6 transition-colors hover:border-accent-600 light:border-surface-200 light:hover:border-accent-700">
					<a href={`/reports/${report.slug}`} class="no-underline">
						<h2 class="text-xl font-semibold text-surface-100 light:text-surface-900">
							{report.title}
						</h2>
					</a>
					{blurbs[report.slug] && (
						<p class="mt-2 text-surface-400 light:text-surface-600">{blurbs[report.slug]}</p>
					)}
					<p class="mt-3 text-sm text-surface-500 light:text-surface-500">
						{report.partCount} {report.partCount === 1 ? 'part' : 'parts'}
					</p>
				</li>
			))}
		</ul>
	</main>

	<Footer />
</BaseLayout>
